{
  "name": "kraft-mortgages-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "pnpm -r --filter @kraft/web dev",
    "build": "pnpm --filter @kraft/web build",
    "start": "pnpm --filter @kraft/web start",
    "typecheck": "pnpm --filter @kraft/web typecheck",
    "lint": "pnpm --filter @kraft/web lint",
    "db:migrate": "pnpm --filter @kraft/prisma prisma migrate dev",
    "db:generate": "pnpm --filter @kraft/prisma prisma generate",
    "seed": "pnpm --filter @kraft/prisma ts-node ./packages/prisma/seed.ts",
    "test": "pnpm --filter @kraft/web test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": "22.x"
  }
}
