# =============================================================================
# Kraft Mortgages web app — environment variable reference
# -----------------------------------------------------------------------------
# MIRROR of apps/web/.env.example (the canonical copy). Next.js only loads env
# files from apps/web/, so a .env.local at the repo root is NOT read. Local dev:
#   cp apps/web/.env.example apps/web/.env.local   (never commit .env.local)
# In production every value lives in Vercel → Project Settings → Environment
# Variables. Keep this file and apps/web/.env.example identical.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time:
# never put a secret in one, and redeploy after changing one.
# Legend: [required] app feature breaks without it · [optional] has a fallback
#         or only enables an add-on · [unused] documented but not read by code
# Inventory generated by the 2026-10 platform audit; see
# DEVLOG/audit-2026-10/platform-build-deps.md for where each one is read.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Canonical origin (sitemap, schema, OpenRouter referer, Meta CAPI). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.kraftmortgages.ca
# [optional] Public base URL used to build the Twilio voice callback URL
# (app/api/voice/twilio/outbound). Misnamed — no NextAuth in this app.
# Defaults to http://localhost:3000, so set it in production if Twilio is used.
NEXTAUTH_URL=

# --- Firebase (client SDK; public by design) ------------------------------------
# [required for admin login / dashboard]
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only) -----------------------------------------------
# [required] Set ONE of the following credential forms:
#  1) Full service-account JSON on a single line (preferred)
FIREBASE_SERVICE_ACCOUNT_JSON=
#  2) Legacy name for the same JSON (lib/firebaseAdmin.ts)
FIREBASE_SERVICE_ACCOUNT=
#  3) Split fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" (quoted, \n escaped)
FIREBASE_PRIVATE_KEY=

# --- Admin area ------------------------------------------------------------------
# [required in production] HTTP Basic Auth for /admin/* (middleware.ts).
# Without BOTH, /admin returns 503 in production (fails closed).
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# --- Relational DB (optional) -----------------------------------------------------
# [optional] Prisma/Postgres. Only used when set AND the Prisma client is generated;
# otherwise leads/rates/reports use Firestore (lib/db.ts isPrismaEnabled()).
DATABASE_URL=

# --- LLM providers (at least one required for chat / content pipeline) ---------
# OpenRouter: both spellings are accepted everywhere.
OPENROUTER_API_KEY=
OPEN_ROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini key; also used for Google Custom Search.
GOOGLE_API_KEY=
# [optional] NVIDIA NIM fallback model for /api/chat
NVIDIA_API_KEY=
# [optional] Google Programmable Search engine id (lib/ai/tools/web-search-tools.ts)
GOOGLE_SEARCH_ENGINE_ID=
# [optional] Tavily web search for the content pipeline
TAVILY_API_KEY=
# [optional] Model overrides for the content pipeline (lib/ai/llm.ts); defaults are in code.
LLM_OPENAI_MODEL=
LLM_ANTHROPIC_MODEL=
LLM_GEMINI_MODEL=
LLM_OPENROUTER_MODEL=

# --- Rates / underwriting data feeds (optional; defaults shown) ------------------
# RATES_FEED_URL=https://blog.kraftmortgages.ca/current_rates.json
RATES_FEED_URL=
# CRITERIA_MATRIX_URL=https://blog.kraftmortgages.ca/underwriting_criteria_matrix.json
CRITERIA_MATRIX_URL=
# Local override path for the rates JSON (lib/rates.ts)
RATES_DATA_PATH=
# Python FastAPI service for /api/cron/pull-rates and /api/documents (503 when unset)
FASTAPI_BASE_URL=
# [optional] When set, GET /api/lenders with header `x-api-key: <value>` returns full
# records incl. lender BDM contacts; without it BDM contacts are always redacted.
LENDERS_API_KEY=

# --- Voice ----------------------------------------------------------------------
# Thinkrr browser widget (public widget keys). An agent whose key is unset is hidden.
NEXT_PUBLIC_THINKRR_ENGLISH_WIDGET_KEY=
NEXT_PUBLIC_THINKRR_HINDI_WIDGET_KEY=
# Thinkr outbound calling + webhook (server)
THINKR_API_KEY=
THINKR_AGENT_ID=
THINKR_CALLER_PHONE=
THINKR_OUTBOUND_SCENARIO_ID=
# Bearer secret Thinkrr sends to /api/webhooks/thinkr (set it on both sides)
THINKR_WEBHOOK_SECRET=
# ElevenLabs TTS (/api/voice/generate)
ELEVENLABS_API_KEY=
# Vapi outbound calls on contact-form leads (lib/voice/vapi.ts still has hard-coded
# fallbacks: ROTATE the key, set these three, then delete the fallbacks — DEVLOG BUG-002)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Twilio. TWILIO_AUTH_TOKEN is also required to verify Twilio callback signatures.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=

# --- Leads / CRM / notifications ------------------------------------------------
# Discord channel webhook for new-lead alerts (also the safety net when the CRM is down)
DISCORD_LEAD_WEBHOOK_URL=
# n8n webhook that creates the Twenty CRM lead (code default = current n8n contact-form URL)
TWENTY_WEBHOOK_URL=
# GoHighLevel inbound webhook for /api/business-funding (code default = current URL)
# [optional] Shared secret sent as `X-Webhook-Secret` on CRM webhooks. Set it here and
# deploy FIRST, then make the VPS receiver require it.
CRM_WEBHOOK_SECRET=
# HubSpot (lib/crm/hubspot is not wired into any route yet)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_KEY=
# Brevo transactional email (lib/email/brevo-client.ts is inert until the SDK is added)
BREVO_API_KEY=

# --- Facebook Lead Ads ------------------------------------------------------------
# Page webhook (/api/webhooks/facebook). Without FACEBOOK_APP_SECRET, leads are
# forwarded but no AI call is placed. AI calls also need a consent question in the form.
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# --- Analytics / PWA ------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SEGMENT_WRITE_KEY=
# Any non-empty value (even "false") enables the service worker; leave empty to disable.
NEXT_PUBLIC_PWA_ENABLED=

# --- AI content pipeline / cron -------------------------------------------------
# Shared secret for /api/orchestrate (x-api-key or Bearer), /api/cron/daily and
# /api/blog/ingest. Use a long random string.
CREWAPI_SECRET=
# [optional] Alternative token accepted by /api/blog/ingest
BLOG_INGEST_TOKEN=
# [optional] External crew service base URL used server-side by /api/cron/daily
CREWAPI_BASE_URL=
# [legacy] Older name for the same base URL; the dashboard now always calls same-origin /api
NEXT_PUBLIC_CREWAPI_BASE_URL=
# "firestore" = skip WordPress and publish to the Firestore CMS only
AI_MODE=firestore
# AI-written posts are saved as DRAFTS for review unless this is exactly "true".
AI_AUTO_PUBLISH=
# [optional] WordPress publishing (only when AI_MODE != firestore)
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# [optional] Google Search Console for /api/strategy/weekly
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=https://www.kraftmortgages.ca
# [strongly recommended] Vercel sends `Authorization: Bearer $CRON_SECRET` on cron
# invocations when this is set; lib/auth.ts verifyCronRequest() checks it
# (without it, cron routes fall back to a spoofable user-agent check).
CRON_SECRET=
